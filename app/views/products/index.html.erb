
<h1>All Products</h1>

<p>Total Products: <%= @products.count %></p>

<ul>
  <% @products.each do |product| %>
    <li>
      <%= link_to product.title, product_path(product) %>
      - <%= number_to_currency(product.price) %>
      - Stock: <%= product.stock_quantity %>
      - Category: <%= product.category.name %>
    </li>
  <% end %>
</ul>
