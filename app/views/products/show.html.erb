
<h1><%= @product.title %></h1>

<p>
  <strong>Description:</strong>
  <%= @product.description.presence || "No description available" %>
</p>

<p>
  <strong>Price:</strong>
  <%= number_to_currency(@product.price) %>
</p>

<p>
  <strong>Stock Quantity:</strong>
  <%= @product.stock_quantity %>
</p>

<%= link_to "Back to Products", products_path %>
